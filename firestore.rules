rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isProjectMember(projectId) {
      return isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function getMemberRole(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role;
    }

    function isProjectAdmin(projectId) {
      return isProjectMember(projectId) && getMemberRole(projectId) in ['owner', 'admin'];
    }

    function isProjectOwner(projectId) {
      return isProjectMember(projectId) && getMemberRole(projectId) == 'owner';
    }

    function isValidAssignee(projectId, assigneeUid) {
      return assigneeUid == '' || (
        isValidId(assigneeUid)
        && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(assigneeUid))
      );
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidProjectMembership(data, projectId) {
      return data.keys().hasAll(['projectId', 'projectName', 'projectKey', 'role', 'joinedAt'])
        && data.keys().hasOnly(['projectId', 'projectName', 'projectKey', 'role', 'joinedAt'])
        && isValidId(data.projectId)
        && data.projectId == projectId
        && data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 80
        && data.projectKey is string && data.projectKey.size() >= 2 && data.projectKey.size() <= 6 && data.projectKey.matches('^[A-Z0-9]{2,6}$')
        && data.role in ['owner', 'admin', 'member']
        && data.joinedAt is timestamp;
    }

    function isValidNotification(data, userId, notificationId) {
      return data.keys().hasAll([
          'id', 'recipientUid', 'actorUid', 'actorName', 'projectId',
          'projectName', 'taskId', 'taskKey', 'type', 'message', 'read', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'recipientUid', 'actorUid', 'actorName', 'projectId',
          'projectName', 'taskId', 'taskKey', 'type', 'message', 'read', 'dedupeKey', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == notificationId
        && isValidId(data.recipientUid)
        && data.recipientUid == userId
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 80
        && data.taskId is string && data.taskId.size() <= 128
        && data.taskKey is string && data.taskKey.size() <= 16
        && data.type in [
          'task_assigned', 'task_reassigned', 'task_moved', 'task_status_changed',
          'task_completed', 'comment_added', 'user_mentioned', 'due_approaching',
          'task_overdue', 'member_joined', 'sprint_started', 'sprint_completed',
          'dependency_blocked', 'project_invitation'
        ]
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 300
        && data.read is bool
        && (!('dedupeKey' in data) || (data.dedupeKey is string && data.dedupeKey.size() <= 160))
        && data.createdAt is timestamp;
    }

    function isValidNotificationPreference(data) {
      return data.keys().hasAll(['all', 'assignments', 'mentions', 'reminders', 'projectActivity', 'updatedAt'])
        && data.keys().hasOnly(['all', 'assignments', 'mentions', 'reminders', 'projectActivity', 'updatedAt'])
        && data.all is bool
        && data.assignments is bool
        && data.mentions is bool
        && data.reminders is bool
        && data.projectActivity is bool
        && data.updatedAt is timestamp;
    }

    function isValidSavedFilter(data, filterId) {
      return data.keys().hasAll(['id', 'name', 'projectId', 'criteriaJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'projectId', 'criteriaJson', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == filterId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.projectId is string && data.projectId.size() <= 128
        && data.criteriaJson is string && data.criteriaJson.size() >= 2 && data.criteriaJson.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomTemplate(data, templateId) {
      return data.keys().hasAll(['id', 'name', 'description', 'category', 'payloadJson', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'description', 'category', 'payloadJson', 'createdAt'])
        && isValidId(data.id) && data.id == templateId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 500
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 16000
        && data.createdAt is timestamp;
    }

    function isValidProject(data, projectId) {
      return data.keys().hasAll(['id', 'name', 'key', 'description', 'ownerId', 'taskCounter', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'key', 'description', 'ownerId', 'taskCounter', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == projectId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.key is string && data.key.size() >= 2 && data.key.size() <= 6 && data.key.matches('^[A-Z0-9]{2,6}$')
        && data.description is string && data.description.size() <= 500
        && isValidId(data.ownerId)
        && data.taskCounter is int && data.taskCounter >= 0 && data.taskCounter <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectMember(data, memberId) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'role', 'inviteCode', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'inviteCode', 'joinedAt'])
        && isValidId(data.uid)
        && data.uid == memberId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role in ['owner', 'admin', 'member']
        && data.inviteCode is string && data.inviteCode.size() <= 32
        && data.joinedAt is timestamp;
    }

    function isValidTagList(tags) {
      return tags is list
        && tags.size() <= 5
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 24));
    }

    function isValidSubtaskList(subtasks) {
      return subtasks is list
        && subtasks.size() <= 25
        && (subtasks.size() == 0 || (subtasks[0] is map && subtasks[0].keys().hasAll(['id', 'title', 'completed']) && subtasks[0].title is string && subtasks[0].title.size() <= 160 && subtasks[0].completed is bool));
    }

    function isValidIdArray(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    function isValidTaskCard(data, projectId, taskId) {
      return data.keys().hasAll([
          'id', 'projectId', 'taskKey', 'title', 'description', 'status', 'priority',
          'position', 'assigneeUid', 'assigneeName', 'assigneePhoto', 'tags',
          'dueDate', 'commentCount', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'taskKey', 'title', 'description', 'status', 'priority',
          'position', 'assigneeUid', 'assigneeName', 'assigneePhoto', 'tags',
          'dueDate', 'startDate', 'sprintId', 'milestoneId', 'estimatedMinutes',
          'actualMinutes', 'subtasks', 'blockedBy', 'blocks', 'relatedTaskIds',
          'recurrence', 'overrideReason', 'commentCount', 'createdBy', 'createdByName',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == taskId
        && isValidId(data.projectId) && data.projectId == projectId
        && data.taskKey is string && data.taskKey.size() >= 3 && data.taskKey.size() <= 16
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.status in ['backlog', 'todo', 'in_progress', 'done']
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && (data.position is int || data.position is float)
        && data.assigneeUid is string && data.assigneeUid.size() <= 128
        && data.assigneeName is string && data.assigneeName.size() <= 80
        && data.assigneePhoto is string && data.assigneePhoto.size() <= 500
        && isValidTagList(data.tags)
        && data.dueDate is string && data.dueDate.size() <= 20
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20))
        && (!('sprintId' in data) || (data.sprintId is string && data.sprintId.size() <= 128))
        && (!('milestoneId' in data) || (data.milestoneId is string && data.milestoneId.size() <= 128))
        && (!('estimatedMinutes' in data) || (data.estimatedMinutes is int && data.estimatedMinutes >= 0 && data.estimatedMinutes <= 1000000))
        && (!('actualMinutes' in data) || (data.actualMinutes is int && data.actualMinutes >= 0 && data.actualMinutes <= 1000000))
        && (!('subtasks' in data) || isValidSubtaskList(data.subtasks))
        && (!('blockedBy' in data) || isValidIdArray(data.blockedBy, 15))
        && (!('blocks' in data) || isValidIdArray(data.blocks, 15))
        && (!('relatedTaskIds' in data) || isValidIdArray(data.relatedTaskIds, 15))
        && (!('recurrence' in data) || data.recurrence == null || data.recurrence is map)
        && (!('overrideReason' in data) || (data.overrideReason is string && data.overrideReason.size() <= 300))
        && data.commentCount is int && data.commentCount >= 0 && data.commentCount <= 100000
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTaskComment(data, projectId, taskId, commentId) {
      return data.keys().hasAll([
          'id', 'projectId', 'taskId', 'authorUid', 'authorName', 'authorPhoto',
          'body', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'taskId', 'authorUid', 'authorName', 'authorPhoto',
          'body', 'mentions', 'edited', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == commentId
        && isValidId(data.projectId) && data.projectId == projectId
        && isValidId(data.taskId) && data.taskId == taskId
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorPhoto is string && data.authorPhoto.size() <= 500
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && (!('mentions' in data) || isValidIdArray(data.mentions, 10))
        && (!('edited' in data) || data.edited is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttachment(data, projectId, taskId, attachmentId) {
      return data.keys().hasAll([
          'id', 'projectId', 'taskId', 'name', 'size', 'contentType',
          'storagePath', 'downloadUrl', 'uploadedBy', 'uploadedByName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'taskId', 'name', 'size', 'contentType',
          'storagePath', 'downloadUrl', 'uploadedBy', 'uploadedByName', 'createdAt'
        ])
        && isValidId(data.id) && data.id == attachmentId
        && isValidId(data.projectId) && data.projectId == projectId
        && isValidId(data.taskId) && data.taskId == taskId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.size is int && data.size > 0 && data.size <= 10485760
        && data.contentType is string && data.contentType.size() >= 1 && data.contentType.size() <= 120
        && data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 500
        && data.downloadUrl is string && data.downloadUrl.size() >= 1 && data.downloadUrl.size() <= 1000
        && isValidId(data.uploadedBy)
        && data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidTimeEntry(data, projectId, taskId, entryId) {
      return data.keys().hasAll([
          'id', 'projectId', 'taskId', 'userUid', 'userName',
          'startTime', 'endTime', 'durationMinutes', 'note', 'isManual', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'taskId', 'userUid', 'userName',
          'startTime', 'endTime', 'durationMinutes', 'note', 'isManual', 'createdAt'
        ])
        && isValidId(data.id) && data.id == entryId
        && isValidId(data.projectId) && data.projectId == projectId
        && isValidId(data.taskId) && data.taskId == taskId
        && isValidId(data.userUid)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.startTime is string && data.startTime.size() >= 10 && data.startTime.size() <= 40
        && data.endTime is string && data.endTime.size() >= 10 && data.endTime.size() <= 40
        && data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 14400
        && data.note is string && data.note.size() <= 300
        && data.isManual is bool
        && data.createdAt is timestamp;
    }

    function isValidSprint(data, projectId, sprintId) {
      return data.keys().hasAll([
          'id', 'projectId', 'name', 'goal', 'startDate', 'endDate',
          'status', 'retrospectiveNotes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'name', 'goal', 'startDate', 'endDate',
          'status', 'retrospectiveNotes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == sprintId
        && isValidId(data.projectId) && data.projectId == projectId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.goal is string && data.goal.size() <= 500
        && data.startDate is string && data.startDate.size() >= 10 && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() >= 10 && data.endDate.size() <= 20
        && data.endDate >= data.startDate
        && data.status in ['planned', 'active', 'completed']
        && data.retrospectiveNotes is string && data.retrospectiveNotes.size() <= 2000
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMilestone(data, projectId, milestoneId) {
      return data.keys().hasAll([
          'id', 'projectId', 'name', 'description', 'dueDate',
          'completed', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'name', 'description', 'dueDate',
          'completed', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == milestoneId
        && isValidId(data.projectId) && data.projectId == projectId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 500
        && data.dueDate is string && data.dueDate.size() >= 10 && data.dueDate.size() <= 20
        && data.completed is bool
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivity(data, projectId, activityId) {
      return data.keys().hasAll([
          'id', 'projectId', 'actorUid', 'actorName', 'actorPhoto',
          'action', 'taskId', 'taskKey', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'actorUid', 'actorName', 'actorPhoto',
          'action', 'taskId', 'taskKey', 'summary', 'createdAt'
        ])
        && isValidId(data.id) && data.id == activityId
        && isValidId(data.projectId) && data.projectId == projectId
        && isValidId(data.actorUid) && data.actorUid == request.auth.uid
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && data.actorPhoto is string && data.actorPhoto.size() <= 500
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 64
        && data.taskId is string && data.taskId.size() <= 128
        && data.taskKey is string && data.taskKey.size() <= 16
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidProjectInvite(data, inviteCode) {
      return data.keys().hasAll([
          'code', 'projectId', 'projectName', 'projectKey', 'createdBy',
          'role', 'active', 'singleUse', 'maxUses', 'useCount',
          'invitedEmail', 'expiresAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'code', 'projectId', 'projectName', 'projectKey', 'createdBy',
          'role', 'active', 'singleUse', 'maxUses', 'useCount',
          'invitedEmail', 'expiresAt', 'createdAt'
        ])
        && isValidId(data.code) && data.code == inviteCode
        && data.code.size() >= 6 && data.code.size() <= 32
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 80
        && data.projectKey is string && data.projectKey.size() >= 2 && data.projectKey.size() <= 6 && data.projectKey.matches('^[A-Z0-9]{2,6}$')
        && isValidId(data.createdBy)
        && data.role in ['admin', 'member']
        && data.active is bool
        && data.singleUse is bool
        && data.maxUses is int && data.maxUses >= 0 && data.maxUses <= 1000
        && data.useCount is int && data.useCount >= 0 && data.useCount <= 1000
        && data.invitedEmail is string && data.invitedEmail.size() <= 254
        && data.expiresAt is timestamp
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // User Collections
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /projectMemberships/{projectId} {
        allow get: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && isValidProjectMembership(incoming(), projectId)
          && incoming().joinedAt == request.time
          && existsAfter(/databases/$(database)/documents/projects/$(projectId)/members/$(userId));
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && isValidProjectMembership(incoming(), projectId)
          && incoming().projectId == existing().projectId
          && incoming().joinedAt == existing().joinedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['projectName', 'projectKey', 'role']);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(projectId) && isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidNotification(incoming(), userId, notificationId)
          && incoming().actorUid == request.auth.uid
          && incoming().read == false
          && incoming().createdAt == request.time
          && isProjectMember(incoming().projectId)
          && exists(/databases/$(database)/documents/projects/$(incoming().projectId)/members/$(userId));
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(notificationId)
          && isOwner(userId)
          && isValidNotification(incoming(), userId, notificationId)
          && incoming().recipientUid == existing().recipientUid
          && incoming().actorUid == existing().actorUid
          && incoming().projectId == existing().projectId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }

      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
        allow list: if false;
        allow create, update: if isSignedIn()
          && isValidId(userId)
          && prefId == 'notifications'
          && isOwner(userId)
          && isValidNotificationPreference(incoming())
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }

      match /savedFilters/{filterId} {
        allow get: if isValidId(userId) && isValidId(filterId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isVerifiedUser()
          && isValidId(userId) && isValidId(filterId) && isOwner(userId)
          && isValidSavedFilter(incoming(), filterId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId) && isValidId(filterId) && isOwner(userId)
          && isValidSavedFilter(incoming(), filterId)
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'projectId', 'criteriaJson', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(filterId) && isOwner(userId);
      }

      match /templates/{templateId} {
        allow get: if isValidId(userId) && isValidId(templateId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isVerifiedUser()
          && isValidId(userId) && isValidId(templateId) && isOwner(userId)
          && isValidCustomTemplate(incoming(), templateId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(templateId) && isOwner(userId);
      }
    }

    // Public Collaborator Profiles (No Email PII)
    match /userProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Projects & Subcollections
    // -------------------------------------------------------------------------
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isProjectMember(projectId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming(), projectId)
        && incoming().ownerId == request.auth.uid
        && incoming().taskCounter == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming(), projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isProjectAdmin(projectId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt'])) ||
          (isProjectMember(projectId)
            && incoming().taskCounter == existing().taskCounter + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['taskCounter', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(projectId) && isProjectOwner(projectId);

      // Members (Master Gate Source of Truth)
      match /members/{memberId} {
        allow get: if isValidId(projectId) && isValidId(memberId) && isProjectMember(projectId);
        allow list: if isProjectMember(projectId);
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(memberId)
          && isValidProjectMember(incoming(), memberId)
          && incoming().uid == request.auth.uid
          && incoming().joinedAt == request.time
          && (
            (incoming().role == 'owner'
              && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid) ||
            (incoming().role in ['admin', 'member']
              && incoming().inviteCode.size() >= 10
              && exists(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode))
              && get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.active == true
              && get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.projectId == projectId
              && get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.role == incoming().role
              && get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.expiresAt > request.time
              && (get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.maxUses == 0
                || get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.useCount
                  < get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.maxUses)
              && (get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.invitedEmail == ''
                || get(/databases/$(database)/documents/projectInvites/$(incoming().inviteCode)).data.invitedEmail == request.auth.token.email))
          );
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(memberId)
          && isValidProjectMember(incoming(), memberId)
          && incoming().uid == existing().uid
          && incoming().joinedAt == existing().joinedAt
          && incoming().inviteCode == existing().inviteCode
          && (
            (isProjectOwner(projectId)
              && memberId != request.auth.uid
              && existing().role != 'owner'
              && incoming().role in ['admin', 'member']
              && incoming().diff(existing()).affectedKeys().hasOnly(['role'])) ||
            (memberId == request.auth.uid
              && incoming().role == existing().role
              && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']))
          );
        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(memberId)
          && existing().role != 'owner'
          && (
            (isProjectAdmin(projectId) && memberId != request.auth.uid) ||
            memberId == request.auth.uid
          );
      }

      // Project-Scoped Invites (Admin directory for pending/revoked invites)
      match /invites/{inviteCode} {
        allow get: if isValidId(projectId) && isValidId(inviteCode) && isProjectAdmin(projectId);
        allow list: if isProjectAdmin(projectId);
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(inviteCode)
          && isValidProjectInvite(incoming(), inviteCode)
          && incoming().projectId == projectId
          && incoming().createdBy == request.auth.uid
          && incoming().active == true
          && incoming().useCount == 0
          && incoming().createdAt == request.time
          && isProjectAdmin(projectId);
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(inviteCode)
          && isValidProjectInvite(incoming(), inviteCode)
          && incoming().code == existing().code
          && incoming().projectId == existing().projectId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && (
            (isProjectAdmin(projectId) && incoming().diff(existing()).affectedKeys().hasOnly(['active'])) ||
            (isSignedIn()
              && incoming().useCount == existing().useCount + 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['useCount'])
              && existsAfter(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)))
          );
        allow delete: if isVerifiedUser() && isValidId(projectId) && isValidId(inviteCode) && isProjectAdmin(projectId);
      }

      // Sprints
      match /sprints/{sprintId} {
        allow get: if isValidId(projectId) && isValidId(sprintId) && isProjectMember(projectId);
        allow list: if isProjectMember(projectId);
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(sprintId)
          && isValidSprint(incoming(), projectId, sprintId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isProjectAdmin(projectId);
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(sprintId)
          && isValidSprint(incoming(), projectId, sprintId)
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isProjectAdmin(projectId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'goal', 'startDate', 'endDate', 'status', 'retrospectiveNotes', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isValidId(projectId) && isValidId(sprintId) && isProjectAdmin(projectId);
      }

      // Milestones
      match /milestones/{milestoneId} {
        allow get: if isValidId(projectId) && isValidId(milestoneId) && isProjectMember(projectId);
        allow list: if isProjectMember(projectId);
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(milestoneId)
          && isValidMilestone(incoming(), projectId, milestoneId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isProjectAdmin(projectId);
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(milestoneId)
          && isValidMilestone(incoming(), projectId, milestoneId)
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isProjectAdmin(projectId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'dueDate', 'completed', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isValidId(projectId) && isValidId(milestoneId) && isProjectAdmin(projectId);
      }

      // Immutable Project Audit History
      match /activities/{activityId} {
        allow get: if isValidId(projectId) && isValidId(activityId) && isProjectMember(projectId);
        allow list: if isProjectMember(projectId);
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(activityId)
          && isValidActivity(incoming(), projectId, activityId)
          && incoming().createdAt == request.time
          && isProjectMember(projectId);
        allow update, delete: if false;
      }

      // Tasks
      match /tasks/{taskId} {
        allow get: if isValidId(projectId) && isValidId(taskId) && isProjectMember(projectId);
        allow list: if isProjectMember(projectId);
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(taskId)
          && isValidTaskCard(incoming(), projectId, taskId)
          && incoming().createdBy == request.auth.uid
          && incoming().commentCount == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isProjectMember(projectId)
          && isValidAssignee(projectId, incoming().assigneeUid);
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(taskId)
          && isValidTaskCard(incoming(), projectId, taskId)
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().taskKey == existing().taskKey
          && incoming().createdBy == existing().createdBy
          && incoming().createdByName == existing().createdByName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isProjectMember(projectId)
          && isValidAssignee(projectId, incoming().assigneeUid)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'position', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'position', 'overrideReason', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['dueDate', 'startDate', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['subtasks', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['actualMinutes', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'status', 'priority', 'position',
              'assigneeUid', 'assigneeName', 'assigneePhoto', 'tags', 'dueDate',
              'startDate', 'sprintId', 'milestoneId', 'estimatedMinutes', 'actualMinutes',
              'subtasks', 'blockedBy', 'blocks', 'relatedTaskIds', 'recurrence',
              'overrideReason', 'updatedAt'
            ]) ||
            (incoming().commentCount == existing().commentCount + 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['commentCount', 'updatedAt']))
          );
        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(taskId)
          && isProjectMember(projectId)
          && (existing().createdBy == request.auth.uid || isProjectAdmin(projectId));

        // Comments (with @mentions and author-only edits)
        match /comments/{commentId} {
          allow get: if isValidId(projectId) && isValidId(taskId) && isValidId(commentId) && isProjectMember(projectId);
          allow list: if isProjectMember(projectId);
          allow create: if isVerifiedUser()
            && isValidId(projectId)
            && isValidId(taskId)
            && isValidId(commentId)
            && isValidTaskComment(incoming(), projectId, taskId, commentId)
            && incoming().authorUid == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && isProjectMember(projectId)
            && exists(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId));
          allow update: if isVerifiedUser()
            && isValidId(projectId)
            && isValidId(taskId)
            && isValidId(commentId)
            && isValidTaskComment(incoming(), projectId, taskId, commentId)
            && incoming().id == existing().id
            && incoming().projectId == existing().projectId
            && incoming().taskId == existing().taskId
            && incoming().authorUid == existing().authorUid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && existing().authorUid == request.auth.uid
            && isProjectMember(projectId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['body', 'mentions', 'edited', 'updatedAt']);
          allow delete: if isVerifiedUser()
            && isValidId(projectId)
            && isValidId(taskId)
            && isValidId(commentId)
            && isProjectMember(projectId)
            && (existing().authorUid == request.auth.uid || isProjectAdmin(projectId));
        }

        // Attachments metadata
        match /attachments/{attachmentId} {
          allow get: if isValidId(projectId) && isValidId(taskId) && isValidId(attachmentId) && isProjectMember(projectId);
          allow list: if isProjectMember(projectId);
          allow create: if isVerifiedUser()
            && isValidId(projectId)
            && isValidId(taskId)
            && isValidId(attachmentId)
            && isValidAttachment(incoming(), projectId, taskId, attachmentId)
            && incoming().uploadedBy == request.auth.uid
            && incoming().createdAt == request.time
            && isProjectMember(projectId)
            && exists(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId));
          allow update: if false;
          allow delete: if isVerifiedUser()
            && isValidId(projectId)
            && isValidId(taskId)
            && isValidId(attachmentId)
            && isProjectMember(projectId)
            && (existing().uploadedBy == request.auth.uid || isProjectAdmin(projectId));
        }

        // Time Entries
        match /timeEntries/{entryId} {
          allow get: if isValidId(projectId) && isValidId(taskId) && isValidId(entryId) && isProjectMember(projectId);
          allow list: if isProjectMember(projectId);
          allow create: if isVerifiedUser()
            && isValidId(projectId)
            && isValidId(taskId)
            && isValidId(entryId)
            && isValidTimeEntry(incoming(), projectId, taskId, entryId)
            && incoming().userUid == request.auth.uid
            && incoming().createdAt == request.time
            && isProjectMember(projectId)
            && exists(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId));
          allow update: if false;
          allow delete: if isVerifiedUser()
            && isValidId(projectId)
            && isValidId(taskId)
            && isValidId(entryId)
            && isProjectMember(projectId)
            && (existing().userUid == request.auth.uid || isProjectAdmin(projectId));
        }
      }
    }

    // Publicly Redeemable Invitation Lookup (exact code only, zero list)
    match /projectInvites/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(inviteCode)
        && isValidProjectInvite(incoming(), inviteCode)
        && incoming().createdBy == request.auth.uid
        && incoming().active == true
        && incoming().useCount == 0
        && incoming().createdAt == request.time
        && isProjectAdmin(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(inviteCode)
        && isValidProjectInvite(incoming(), inviteCode)
        && incoming().code == existing().code
        && incoming().projectId == existing().projectId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (isProjectAdmin(existing().projectId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['active'])) ||
          (existing().active == true
            && existing().expiresAt > request.time
            && (existing().maxUses == 0 || existing().useCount < existing().maxUses)
            && incoming().useCount == existing().useCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['useCount'])
            && existsAfter(/databases/$(database)/documents/projects/$(existing().projectId)/members/$(request.auth.uid)))
        );
      allow delete: if isVerifiedUser() && isValidId(inviteCode) && isProjectAdmin(existing().projectId);
    }
  }
}
