# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP and WebSocket listening port (default 3000)
PORT="3000"

# ALLOWED_ORIGINS: Comma-separated list of approved CORS origins in production
ALLOWED_ORIGINS="https://your-production-domain.example.com"

# EMAIL_PROVIDER_API_KEY: Optional transactional email API key (e.g. Resend/SendGrid)
# Leave unset if email notifications are disabled.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="notifications@cadence.example.com"
